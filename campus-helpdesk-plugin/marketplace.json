{
  "id": "campus-helpdesk",
  "name": "Campus Helpdesk",
  "version": "1.0.0",
  "description": "An AI agent plugin for Nimbus Labs University campus operations. Provides accurate, grounded answers about class timetables (CSE-A and CSE-B), student fee status, and hostel regulations. Includes a security hook that blocks writes to protected file paths.",
  "author": {
    "name": "Nimbus Labs University IT Division",
    "email": "it-support@nimbusuni.edu"
  },
  "license": "MIT",
  "keywords": ["campus", "timetable", "university", "helpdesk", "schedule", "mcp", "education"],
  "categories": ["Education", "Productivity"],
  "entryPoint": "gemini-extension.json",
  "capabilities": {
    "skills": ["timetable-helper"],
    "mcpServers": ["campus-helpdesk-mcp"],
    "slashCommands": ["/check-timetable"],
    "hooks": ["guard-protected-paths"]
  },
  "requirements": {
    "python": ">=3.8",
    "packages": ["mcp>=1.0.0"]
  },
  "install": {
    "steps": [
      "pip3 install mcp>=1.0.0",
      "agy plugin install campus-helpdesk-plugin/gemini-extension.json"
    ]
  },
  "homepage": "https://nimbusuni.edu/campus-helpdesk",
  "repository": "https://github.com/nimbusuni/campus-helpdesk-toolchain",
  "screenshots": [],
  "changelog": {
    "1.0.0": "Initial release: timetable lookup, fee status MCP tool, hostel rules, security write-guard hook."
  }
}
